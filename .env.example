# Copy this file to `.env.local` and fill in the value. `.env.local` is
# gitignored; this file is committed as the reference.

# Web3Forms access key — the contact form posts to it and it emails the
# submission to the address the key was issued for (gregoryibo7@gmail.com).
#
# Get one free in ~30 seconds: https://web3forms.com — enter the email you
# want submissions delivered to, and the key arrives in that inbox.
#
# This key is PUBLIC by design. It is compiled into the static JS bundle and
# anyone can read it. All it authorises is "send an email to the address this
# key belongs to", so it cannot be used to read anything or send elsewhere.
#
# If this is unset, the contact form falls back to the old mailto button
# rather than rendering a form that would silently drop messages.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional — only needed to serve from a root domain instead of
# kooldudegamedev.github.io/portfolio
# NEXT_PUBLIC_BASE_PATH=""
# NEXT_PUBLIC_SITE_ORIGIN="https://example.com"
