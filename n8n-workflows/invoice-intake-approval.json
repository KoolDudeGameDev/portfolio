              "leftValue": "={{ $json.invoiceKey }}",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a5981891-d00e-4066-b6d0-3ba1ec392760",
