            "vendor": "={{ $(\"[I2] Extract Invoice Fields\").item.json.output.vendor }}",
            "invoiceNumber": "={{ $(\"[I2] Extract Invoice Fields\").item.json.output.invoiceNumber }}",
            "amount": "={{ $(\"[I2] Extract Invoice Fields\").item.json.output.amount }}",
            "currency": "={{ $(\"[I2] Extract Invoice Fields\").item.json.output.currency }}",
            "dueDate": "={{ $(\"[I2] Extract Invoice Fields\").item.json.output.dueDate }}",
            "status": "PENDING",
            "receivedAt": "={{ $now.toISO() }}"
          },
          "matchingColumns": [
            "invoiceKey"
          ],
          "schema": []
        }
      },
      "id": "ef2a84be-8be1-4000-83c2-81d6f55fdeec",
      "name": "[I6] Queue as Pending",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1560,
        60
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $(\"[I0] Invoice Email\").item.json.id }}"
      },
      "id": "4d1863e0-c940-4611-9fd9-82172ae77b19",
