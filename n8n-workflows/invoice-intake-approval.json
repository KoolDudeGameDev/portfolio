      "id": "3b445c00-2c98-4142-a2a3-5f122afb013c",
      "name": "[A1] Read Queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        260,
        660
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.invoiceKey);\nif (rows.some(r => r.status === \"IN_REVIEW\")) return [];\nconst next = rows\n  .filter(r => r.status === \"PENDING\")\n  .sort((a, b) => String(a.receivedAt).localeCompare(String(b.receivedAt)))[0];\nreturn next ? [{ json: next }] : [];"
      },
