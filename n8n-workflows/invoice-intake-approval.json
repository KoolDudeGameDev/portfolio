          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Queue"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "invoiceKey",
              "lookupValue": "={{ $json.invoiceKey }}"
            }
          ]
        }
      },
      "id": "3b243e1a-c50b-42df-9941-3ec750fb2ab7",
      "name": "[I4] Already Queued?",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1040,
        160
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
