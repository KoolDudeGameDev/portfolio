        "message": "=Vendor: {{ $(\"[A2] Pick Next Invoice\").item.json.vendor }}\nInvoice: {{ $(\"[A2] Pick Next Invoice\").item.json.invoiceNumber }}\nAmount: {{ $(\"[A2] Pick Next Invoice\").item.json.amount }} {{ $(\"[A2] Pick Next Invoice\").item.json.currency }}\nDue: {{ $(\"[A2] Pick Next Invoice\").item.json.dueDate }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
