      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        1020,
        620
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-embedding-001"
      },
      "id": "5c319c95-d6ba-468d-9ecf-4c70281e778b",
      "name": "Query Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
        1020,
        800
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.output }}",
              "operator": {
                "type": "string",
                "operation": "notContains"
              },
              "rightValue": "ESCALATE"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "5841df6d-5f3a-4831-98a0-dbfa42d9d07d",
      "name": "[G4] Grounded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1040,
        240
      ]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "=Re: {{ $(\"[G0] New Email\").item.json.subject }}",
        "emailType": "text",
        "message": "={{ $json.output }}",
        "options": {
          "threadId": "={{ $(\"[G0] New Email\").item.json.threadId }}",
          "sendTo": "={{ $(\"[G0] New Email\").item.json.from.value[0].address }}"
        }
      },
      "id": "5fa815b2-3ddf-49ce-87d4-d60533c583f8",
      "name": "[G5] Save as Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1300,
        120
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "addLabels",
        "messageId": "={{ $(\"[G0] New Email\").item.json.id }}",
        "labelIds": [
